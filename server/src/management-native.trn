namespace cusco/service

from /core/collections import list
from /core/documents import document-value, document-result
from /core/errors import throwable
from /deps/cusco-server/management import Management as native-management
from /deps/cusco-server import CreateCompactionDeclaration as native-declaration-request

# Typed domain Serde family: convert backend results to exact core documents.
# Rust is retained because projected domain structs do not implement Terrane's
# document-encodable protocol and source cannot invoke generic native Serialize.
# Remove these concrete bridges when native values can use the core document
# codec directly, preserving typed failures and the 16 MiB boundary budget.
# A generic source helper would still need that unavailable Serialize bound.
function require-domain-document document-value throws throwable; result document-result
    if result.failed
        throw service-error; 'state_error', result.message
    return result.value

function unwrap-domain-document document-value throws throwable; result document-value
    failure = wire-field; result, 'failure'
    if failure.kind != 'none'
        throw service-error; (wire-text; failure, 'code'), (wire-text; failure, 'message')
    return wire-field; result, 'value'

# The projected model list cannot use the bounded source document encoder.
function management-models-document document-value throws throwable; backend ref native-management
    result document-result = rust
        let raw = terrane_document_support::serialize_document(&backend.models());
        DocumentResult::terrane_construct(raw.failed, raw.message.clone(), raw.path.clone(), raw.expected.clone(), raw)
    return require-domain-document; result

# The projected context list cannot use the bounded source document encoder.
function management-contexts-document document-value throws throwable; backend ref native-management
    result document-result = rust
        let raw = terrane_document_support::serialize_document(&backend.contexts());
        DocumentResult::terrane_construct(raw.failed, raw.message.clone(), raw.path.clone(), raw.expected.clone(), raw)
    return require-domain-document; result

