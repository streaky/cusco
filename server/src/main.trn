namespace cusco/service

from /core/collections import list
from /core/errors import throwable
from /core/networking import listen-tcp
from /core/process import arguments, cli-schema, parse-command-line
from /deps/cusco-server import Daemon as native-daemon, DaemonConfig, HttpDebugLevel, SocketAddr as native-socket-addr
from /streaky/http-server import create-application


function effective-http-debug string throws throwable; settings shared ref DaemonConfig, supplied string
    mode string = 'off'
    match settings.http-debug
        case HttpDebugLevel::Safe
            mode = 'safe'
        case HttpDebugLevel::Full
            mode = 'full'
        case HttpDebugLevel::Off
            mode = 'off'
    environment-mode = environment-setting; 'CUSCO_HTTP_DEBUG'
    if environment-mode != none
        mode = environment-mode.lower;
    if supplied != ''
        mode = supplied.lower;
    if mode != 'off' and mode != 'safe' and mode != 'full'
        throw startup-error; 'HTTP debug level must be one of: off, safe, full'
    return mode

# SocketAddr display and IpAddr loopback inspection are not admitted through the
# current projected address facade. Keep these scalar native operations until
# both operations are directly callable from source with IPv4/IPv6 parity.
function listener-address string; address native-socket-addr
    return rust
        address.to_string()

function listener-is-loopback bool; address native-socket-addr
    return rust
        address.ip().is_loopback()

async function main throws throwable;
    schema = instance cli-schema;
        list; 'flag:--help', 'value:--config', 'value:--http-debug'
    parsed = parse-command-line; schema, (arguments;)
    if parsed.diagnostic-messages.length > 0 or parsed.positionals.length > 0
        throw startup-error; 'Usage: cusco-service [--config PATH] [--http-debug off|safe|full]'
    if parsed.flags.length > 0
        print; 'Usage: cusco-service [--config PATH] [--http-debug off|safe|full]'
        return
    config-path string = '/data/config.yaml'
    http-debug string = ''
    for index = 0; index < parsed.option-names.length; index++
        value = parsed.option-values[index]
        if not value.is-text
            throw startup-error; 'Options must be Unicode text'
        if parsed.option-names[index] == '--config'
            config-path = value.text
        else
            http-debug = value.text
    backend = native-daemon::open; config-path
    configuration = backend.configuration;
    settings = shared ref configuration
    service-auth = instance service-policy; settings
    policy = shared ref service-auth
    address = listener-address; settings.listen
    if (policy.anonymous;) and not settings.unsafe-public-unauthenticated
        if not (listener-is-loopback; settings.listen)
            throw startup-error; 'unsafe unauthenticated listener: ' + address
    app = mount-service; (create-application;), (backend.server;), settings, policy
    mode = effective-http-debug; settings, http-debug
    diagnostics http-diagnostics|none = none
    if mode != 'off'
        active-diagnostics = instance http-diagnostics; mode
        observer = active-diagnostics.callback;
        diagnostics = active-diagnostics
        app = app.observe-transport; observer, 65536, mode == 'full'
    listener = await listen-tcp; address
    shutdown = async function none;
        await backend.shutdown;
        return none
    print; 'Cusco listening on ', listener.local-address
    try
        await app.serve-listener-until; move listener, shutdown
    finally
        backend.finish_shutdown;
    # Diagnostics are opt-in: a broken sink must not interrupt response draining,
    # but report its recorded failure via the eventual process status.
    if diagnostics != none
        failure = diagnostics.failure;
        if failure != none
            throw startup-error; 'HTTP diagnostics: ' + failure
