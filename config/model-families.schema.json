{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "families"],
  "properties": {
    "schema_version": { "const": 1 },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "architecture", "model_type", "block_size", "recurrent_checkpoint_interval", "context_limit", "required_components", "tokenizer", "terminal_tokens", "sampler"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "model_type": { "type": "string", "minLength": 1 },
          "block_size": { "type": "integer", "minimum": 1 },
          "recurrent_checkpoint_interval": { "type": "integer", "minimum": 1 },
          "context_limit": { "type": "integer", "minimum": 1 },
          "required_components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["kv", "swa", "recurrent"] } },
          "tokenizer": {
            "type": "object", "additionalProperties": false,
            "required": ["add_bos", "parse_special"],
            "properties": { "add_bos": { "type": "boolean" }, "parse_special": { "type": "boolean" } }
          },
          "terminal_tokens": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
          "sampler": {
            "type": "object", "additionalProperties": false,
            "required": ["kind"], "properties": { "kind": { "const": "greedy" } }
          }
        }
      }
    }
  }
}
